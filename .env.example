# =============================================================================
# AI Quant Research Terminal — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in values to enable real-mode features.
# If you leave keys blank the platform runs fully in MOCK MODE — every feature
# is demonstrable with deterministic stub data, no external services required.
# =============================================================================

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
# APP_MODE=mock       -> all external APIs replaced by deterministic fixtures
# APP_MODE=real       -> uses Anthropic + Finnhub + yfinance + ChromaDB
# APP_MODE=hybrid     -> uses real market data, mock LLM (great for dev)
APP_MODE=mock
APP_ENV=development
LOG_LEVEL=INFO
EDUCATIONAL_DISCLAIMER_ACK=true

# ---------------------------------------------------------------------------
# Anthropic Claude (multi-agent reasoning, thesis, narrative)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TEMPERATURE=0.4

# ---------------------------------------------------------------------------
# Market data providers
# ---------------------------------------------------------------------------
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# ---------------------------------------------------------------------------
# Embeddings / NLP (optional, fallback uses sentence-transformers locally)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite default (zero setup)
DATABASE_URL=sqlite+aiosqlite:///./data/terminal.db
# Postgres example (used in docker-compose):
# DATABASE_URL=postgresql+asyncpg://terminal:terminal@postgres:5432/terminal

# ---------------------------------------------------------------------------
# Redis (cache + pubsub) — falls back to in-memory if unavailable
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_OPTIONAL=true

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=quant_terminal

# ---------------------------------------------------------------------------
# CORS / Frontend
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
SENTRY_DSN=
ENABLE_REQUEST_LOG=true
